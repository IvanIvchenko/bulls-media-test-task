# Leave ANTHROPIC_API_KEY empty to run with the deterministic mock LLM (no network).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
LOG_LEVEL=info
# NODE_ENV=production   # requires a key (REQUIRE_LLM) and stops seeding demo orders (SEED_SAMPLE_ORDERS)
# REQUIRE_LLM=true
# SEED_SAMPLE_ORDERS=false
# LLM_RETRY_BASE_MS=200

# Human review of escalations: set a token (16+ characters) to switch it on (see docs/operations.md)
# REVIEW_TOKEN=
# REVIEW_STALE_AFTER_MS=180000

# HTTP service (npm run serve)
PORT=3000
HOST=127.0.0.1
# DATABASE_PATH=data/store.db
# LLM_TIMEOUT_MS=20000
# LLM_MAX_RETRIES=2
# CLAIM_STALE_AFTER_MS=180000
# CLAIM_WAIT_MS=30000
# CLAIM_POLL_MS=200
